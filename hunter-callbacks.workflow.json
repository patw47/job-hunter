              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "snooze-offer",
      "name": "Snooze Offer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0],
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:{{ $env.HUNTER_BRIDGE_PORT ?? '18798' }}/sheets/snooze",
