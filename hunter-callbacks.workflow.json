        "body": "={{ JSON.stringify({ chat_id: $('Parse Callback').first().json.chat_id, message_id: $('Parse Callback').first().json.message_id, text: '⏳ Génération en cours...', parse_mode: 'Markdown', reply_markup: { inline_keyboard: [] } }) }}",
        "options": {
