    },
    {
      "id": "edit-message-ready",
      "name": "Edit Message Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 200],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_HUNTER_BOT_TOKEN }}/editMessageText",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id: $('Parse Callback').first().json.chat_id, message_id: $('Parse Callback').first().json.message_id, text: '✅ *Documents prêts !*\\n*' + ($json.offer && $json.offer.title ? $json.offer.title : '') + '* @ *' + ($json.offer && $json.offer.company ? $json.offer.company : '') + '*\\n\\n📄 CV et lettre générés sur le serveur.', parse_mode: 'Markdown', reply_markup: { inline_keyboard: [] } }) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "check-services-health",
      "name": "Check Services Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 400],
      "parameters": {
        "method": "GET",
        "url": "=http://127.0.0.1:{{ $env.HUNTER_BRIDGE_PORT ?? '18798' }}/health",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "format-health-message",
      "name": "Format Health Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result = $input.first().json;\nconst chatId = $('Parse Callback').first().json.chat_id;\n\nif (!result || !result.services) {\n  return [{ json: { chat_id: chatId, text: '❌ Impossible de récupérer le statut des services.' } }];\n}\n\nconst services = result.services;\nconst lines = services.map(s => {\n  const icon = s.ok ? '✅' : '❌';\n  const nameMap = { n8n: 'n8n', hunter_bridge: 'Hunter Bridge', openclaw: 'OpenClaw', google_sheets: 'Google Sheets' };\n  const name = nameMap[s.service] || s.service;\n  const detail = (!s.ok && s.error) ? ' — ' + String(s.error).slice(0, 60) : '';\n  return icon + ' ' + name + detail;\n});\n\nconst allOk = services.every(s => s.ok);\nconst header = allOk ? '✅ *Tous les services sont opérationnels*' : '⚠️ *Certains services sont en panne*';\nconst text = header + '\\n\\n' + lines.join('\\n');\n\nreturn [{ json: { chat_id: chatId, text } }];"
      }
    },
    {
      "id": "send-health-reply",
      "name": "Send Health Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 400],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_HUNTER_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id: $json.chat_id, text: $json.text, parse_mode: 'Markdown' }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
