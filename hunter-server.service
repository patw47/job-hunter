[Unit]
Description=Hunter HTTP Bridge — n8n to OpenClaw (job-hunter)
After=network.target openclaw-thehunter.service
Wants=openclaw-thehunter.service

[Service]
Type=simple
User=thehunter
Group=apps
WorkingDirectory=/opt/apps/job-hunter
EnvironmentFile=/opt/apps/job-hunter/.env
Environment=HOME=/home/thehunter
Environment=PATH=/home/thehunter/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=HUNTER_BRIDGE_PORT=18798
Environment=OPENCLAW_CONFIG_PATH=/home/thehunter/.openclaw/openclaw.json
ExecStart=/home/thehunter/venv/bin/python3 /opt/apps/job-hunter/hunter_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hunter-server

[Install]
WantedBy=multi-user.target
