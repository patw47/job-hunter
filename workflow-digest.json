{
  "id": "job-hunter-digest-001",
  "name": "Job Hunter — Digest 60-79% (12h30)",
  "nodes": [
    {
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 12 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "send-digest",
      "name": "Send Digest",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "command": "TELEGRAM_BOT_TOKEN={{ $env.TELEGRAM_HUNTER_BOT_TOKEN }} TELEGRAM_CHAT_ID={{ $env.TELEGRAM_HUNTER_CHAT_ID }} SCORED_OFFERS_FILE=/opt/apps/job-hunter/workspace/today_scored.json /home/thehunter/venv/bin/python3 /opt/apps/job-hunter/telegram_notifier.py --digest"
      }
    },
    {
      "id": "parse-digest-output",
      "name": "Parse Digest Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const exitCode = $input.first().json.exitCode ?? 0;\nconst stdout = ($input.first().json.stdout ?? '').trim();\nconst stderr = ($input.first().json.stderr ?? '').trim();\n\nif (exitCode !== 0) {\n  throw new Error(`telegram_notifier --digest exit ${exitCode}: ${stderr.slice(-300)}`);\n}\n\nconst skipped = stdout.includes('skipped') || stdout === '';\nreturn [{ json: { ok: true, skipped, stdout, stderr } }];"
      }
    },
    {
      "id": "snooze-renotify",
      "name": "Snooze Renotify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 0],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18798/snooze-renotify",
        "sendBody": false,
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Send Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Digest": {
      "main": [
        [
          {
            "node": "Parse Digest Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Digest Output": {
      "main": [
        [
          {
            "node": "Snooze Renotify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "job-hunter"
  },
  "active": false,
  "tags": [
    {
      "name": "job-hunter"
    },
    {
      "name": "epic-4-notifications-telegram"
    },
    {
      "name": "sprint-1-digest"
    }
  ]
}
